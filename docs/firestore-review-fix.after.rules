
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /Users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /Bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read: if true;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if true;
    }

    match /roomTypes/{roomTypeId} {
      allow read: if true;
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    match /Inquiries/{inquiryId} {
      allow read: if true;
      allow write: if true;

      match /replies/{replyId} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /Payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    match /Reviews/{reviewId} {
      allow read: if true;
    }

 
    match /reviews/{reviewId} {
 
  allow read: if resource.data.status == "published"
    || (
      request.auth != null
      && resource.data.userId == request.auth.uid
    );

  // Permit the duplicate-check transaction to read an absent review for an owned booking.
  allow get: if request.auth != null
    && !exists(/databases/$(database)/documents/reviews/$(reviewId))
    && get(/databases/$(database)/documents/Bookings/$(reviewId)).data.userId == request.auth.uid;

  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.rating is int
    && request.resource.data.rating >= 1
    && request.resource.data.rating <= 5
    && request.resource.data.comment is string
    && request.resource.data.bookingId is string;
}

    match /Notifications/{notificationId} {
      allow get: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || notificationId.matches(
            '^' + request.auth.uid + '_.*'
          )
        );

      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;

   
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.role == "customer";

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["read"]);

      allow delete: if false;
    }
  }
}
